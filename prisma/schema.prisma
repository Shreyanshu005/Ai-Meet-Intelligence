generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  actionItems  ActionItem[]
  meetings     Meeting[]
}

model Meeting {
  id           String       @id @default(cuid())
  userId       String
  title        String
  participants String[]
  meetingDate  DateTime
  transcript   Json
  createdAt    DateTime     @default(now())
  actionItems  ActionItem[]
  analysis     Analysis?
  user         User         @relation(fields: [userId], references: [id])
}

model Analysis {
  id          String   @id @default(cuid())
  meetingId   String   @unique
  summary     Json
  decisions   Json
  followUps   Json
  rawResponse String
  analyzedAt  DateTime @default(now())
  meeting     Meeting  @relation(fields: [meetingId], references: [id])
}

model ActionItem {
  id        String       @id @default(cuid())
  meetingId String
  userId    String
  task      String
  assignee  String
  dueDate   DateTime?
  status    ActionStatus @default(PENDING)
  citations Json
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  meeting   Meeting      @relation(fields: [meetingId], references: [id])
  user      User         @relation(fields: [userId], references: [id])
  reminders Reminder[]
}

model Reminder {
  id           String     @id @default(cuid())
  actionItemId String
  sentAt       DateTime   @default(now())
  channel      String
  success      Boolean
  actionItem   ActionItem @relation(fields: [actionItemId], references: [id])
}

enum ActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}
